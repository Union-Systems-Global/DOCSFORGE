{
  "name": "docsforge",
  "private": true,
  "version": "0.0.0",
  "description": "DocsForge - Frontend and Backend Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "test": "npm run --parallel test:frontend",
    "test:frontend": "npm --workspace frontend run test",
    "test:watch:frontend": "npm --workspace frontend run test:watch",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm --workspace frontend run lint"
  }
}
